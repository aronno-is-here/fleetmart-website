PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/fleetmart
JWT_SECRET=CHANGE_ME_random_64_char_string
JWT_REFRESH_SECRET=CHANGE_ME_another_random_64_char_string
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP (optional — leave blank to use console stub)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FleetMart <noreply@fleetmart.com>

# Cloudinary (required for image uploads)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret
