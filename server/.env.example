PORT=5000
# MongoDB must run as a replica set (or sharded cluster): payment fulfillment uses transactions.
# Single-node local example: start mongod with --replSet rs0, run rs.initiate(), then connect below.
MONGODB_URI=mongodb://127.0.0.1:27017/fleetmart?replicaSet=rs0
JWT_SECRET=CHANGE_ME_random_64_char_string
JWT_REFRESH_SECRET=CHANGE_ME_another_random_64_char_string
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP (optional — leave blank to use console stub)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FleetMart <noreply@fleetmart.com>

# Seed credentials (only used by seed.js, development only)
ADMIN_EMAIL=admin@fleetmart.com
ADMIN_PASSWORD=Fleet@Admin2026
DEMO_EMAIL=demo@fleetmart.com
DEMO_PASSWORD=demo123

# Cloudinary (required for image uploads)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# Site URL (used for payment callbacks)
SITE_URL=https://fleetmartbd.vercel.app

# UddoktaPay (required for online payments)
# Use the installation base URL. The /api prefix is added automatically if omitted.
# Sandbox: https://sandbox.uddoktapay.com/api
# Live: your self-hosted UddoktaPay domain (e.g., https://pay.fleetmartbd.com/api)
UDDOKTAPAY_API_KEY=your_api_key
UDDOKTAPAY_BASE_URL=https://sandbox.uddoktapay.com/api

# Google OAuth (required for Google Sign-In)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
# Frontend also needs: VITE_GOOGLE_CLIENT_ID=your_google_client_id (in client/.env)

# Apple Sign-In (required for Apple Sign-In)
# Create at https://developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=your_service_id
# Frontend also needs: VITE_APPLE_CLIENT_ID=your_service_id (in client/.env)

# Optional: create the demo payment-test product on startup (default: off)
ENABLE_DEMO_PRODUCT=false

# Destructive seeder guard. seed.js also requires NODE_ENV=development|test.
# Prefer: npm run seed:reset (adds --reset)
SEED_RESET=false
